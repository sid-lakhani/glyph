# Maintainer: Siddhesh Lakhani <sidlakhani@users.noreply.github.com>
pkgname=glyph-bin
_pkgname=glyph
pkgver=0.1.0
pkgrel=1
pkgdesc="Blazing-fast, minimal Wayland screen OCR & text sniper (precompiled binary)"
arch=('x86_64')
url="https://github.com/sid-lakhani/glyph"
license=('MIT')
depends=('slurp' 'grim' 'wl-clipboard')
provides=('glyph')
conflicts=('glyph' 'glyph-git')
source=("https://github.com/sid-lakhani/glyph/releases/download/v${pkgver}/glyph-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('SKIP')

package() {
    install -Dm755 "${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
