# Maintainer: Siddhesh Lakhani <sidlakhani@users.noreply.github.com>
pkgname=glyph-git
_pkgname=glyph
pkgver=0.1.0.r0.g1321154
pkgrel=1
pkgdesc="Blazing-fast, minimal Wayland screen OCR & text sniper"
arch=('x86_64')
url="https://github.com/sid-lakhani/glyph"
license=('MIT')
depends=('slurp' 'grim' 'wl-clipboard' 'tesseract' 'leptonica')
makedepends=('cargo' 'git' 'pkgconf')
provides=('glyph')
conflicts=('glyph' 'glyph-bin')
source=("git+https://github.com/sid-lakhani/glyph.git")
sha256sums=('SKIP')

pkgver() {
    cd "${_pkgname}"
    git describe --long --tags --always | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --features tesseract
}

check() {
    cd "${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --locked
}

package() {
    cd "${_pkgname}"
    install -Dm755 "target/release/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
